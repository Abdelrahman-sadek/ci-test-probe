# Copy to .env (never commit .env). Every setting is optional unless marked.
DOMAIN=assistant.example.edu
ANTHROPIC_API_KEY=                      # live answers + OCR (offline stand-in when empty)
AGENTKIT_ADMIN_KEY=                     # ≥ 32 random chars: `python -c "import secrets;print(secrets.token_urlsafe(32))"`
AGENTKIT_LOG_KEY=                       # Fernet key: `python -c "from cryptography.fernet import Fernet;print(Fernet.generate_key().decode())"`
AGENTKIT_LOG_SALT=                      # random string for pseudonymous user ids
AGENTKIT_LOG_RETENTION_DAYS=30
AGENTKIT_AUTH=none                      # none | jwt | proxy
AGENTKIT_REQUIRE_LOGIN=0
AGENTKIT_JWT_JWKS=                      # https://<idp>/.well-known/jwks.json  [VERIFY AUC identity provider]
AGENTKIT_JWT_AUDIENCE=
AGENTKIT_JWT_ISSUER=
AGENTKIT_ADMIN_GROUPS=library-staff-admin
AGENTKIT_RATE=30/min
AGENTKIT_EMBED_ORIGINS=https://library.aucegypt.edu
AGENTKIT_WA_VERIFY_TOKEN=
AGENTKIT_WA_APP_SECRET=
AGENTKIT_WA_TOKEN=
AGENTKIT_WA_PHONE_ID=
AGENTKIT_APP_DB=data/app.db              # feedback, history, notices, tickets ("off" to disable)
AGENTKIT_LIBCAL_URL=                    # https://<site>.libcal.com  [VERIFY AUC uses LibCal]
AGENTKIT_LIBCAL_CLIENT_ID=
AGENTKIT_LIBCAL_CLIENT_SECRET=
AGENTKIT_LIBCAL_LID=                    # hours location id
AGENTKIT_LIBCAL_SPACE_LID=              # study-room location id
AGENTKIT_ALMA_URL=                      # https://api-eu.hosted.exlibrisgroup.com
AGENTKIT_ALMA_KEY=                      # Users API key (read-only recommended)
AGENTKIT_ALMA_ALLOW_RENEW=0             # 1 = allow renewals from chat
AGENTKIT_LIBANSWERS_URL=                # https://<site>.libanswers.com
AGENTKIT_LIBANSWERS_TOKEN=
AGENTKIT_LIBANSWERS_QUEUE=
AGENTKIT_SMTP_HOST=                     # email handoff fallback
AGENTKIT_SMTP_PORT=587
AGENTKIT_SMTP_USER=
AGENTKIT_SMTP_PASS=
AGENTKIT_SMTP_FROM=
AGENTKIT_HANDOFF_EMAIL=                 # reference desk mailbox
AGENTKIT_LOW_CONFIDENCE=0.7             # OCR pages below this go to the correction queue

# Resilience and cost
AGENTKIT_LLM_TIMEOUT=30                 # seconds per model call
AGENTKIT_LLM_COOLDOWN=60                # after 3 failures, skip the model this long (answers from search results)
AGENTKIT_DAILY_BUDGET_USD=              # above this estimated spend per day, answer from search results only

# Operations
AGENTKIT_TICKET_SLA_HOURS=48            # unanswered handoffs older than this are escalated (agentkit tickets-check)
AGENTKIT_ESCALATION_EMAIL=              # head of reference; receives the overdue list
AGENTKIT_STALE_DAYS=120                 # sources not re-ingested for this long show on the freshness report
AGENTKIT_SNAPSHOTS=5                    # index snapshots kept for `agentkit rollback`

# OCR
AGENTKIT_OCR_MAX_PAGES_PER_DOC=200      # pages beyond this are marked ocr-skipped (cost cap)
AGENTKIT_FIGURES=0                      # 1: describe charts and photos on scanned pages (extra model calls)

# Pilot gate (`agentkit preflight`; with AGENTKIT_PILOT=1, `serve` refuses to start until it passes)
AGENTKIT_PILOT=0
AGENTKIT_PILOT_MIN_GOLDEN=0.95          # live-model golden pass rate required
AGENTKIT_PILOT_MIN_HELDOUT=0.8          # live-model held-out pass rate required
AGENTKIT_EVAL_DIR=data                  # where eval reports (*-report.json) are read from
AGENTKIT_PROXY_SECRET=                  # proxy mode: shared secret Caddy/SSO adds as X-Proxy-Secret

# Agentic retrieval
AGENTKIT_MAX_RETRIEVAL_ATTEMPTS=2       # 1 retrieval + 1 rewritten retry before handing off
AGENTKIT_GRADE=1                        # live mode: a fast model drops retrieved passages that don't help

# Dashboard, costs and alerts (plan 7)
AGENTKIT_STAFF_GROUPS=library-staff     # directory groups with staff dashboard rights (knowledge, service)
AGENTKIT_VIEWER_GROUPS=                 # read-only dashboard groups (overview, quality)
AGENTKIT_MONTHLY_BUDGET_USD=            # monthly cap next to the daily one
AGENTKIT_BUDGET_ALERTS=50,80,95         # % of budget that alert once per day/month
AGENTKIT_BUDGET_BRAKE=0.8               # above this share, grading/rewriting/critic pause before answers degrade
AGENTKIT_ALERT_WEBHOOK=                 # https webhook (Teams/Slack) for budget alerts
AGENTKIT_GAP_MIN_USERS=3                # a knowledge gap is shown only when this many people asked
AGENTKIT_EVAL_CANDIDATES=data/eval-candidates.md

# Critic and semantic cache
AGENTKIT_CRITIC=1                       # check research/policy answers before showing them
AGENTKIT_SEMCACHE=0                     # 1: reuse answers for safe paraphrases (turn on after the live eval)
AGENTKIT_SEMCACHE_THRESHOLD=0.88
AGENTKIT_SEMCACHE_MODEL=                # optional small embedding model, e.g. intfloat/multilingual-e5-small
AGENTKIT_REDIS_URL=                     # share the semantic cache between workers (pip install ".[redis]")

# Thesis harvesting
AGENTKIT_OAI_DEPT_FIELD=publisher       # Dublin Core field holding the department [VERIFY] for Digital Commons
