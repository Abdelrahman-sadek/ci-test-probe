# HTTPS reverse proxy. For SSO, put oauth2-proxy (or the university's SAML/OIDC gateway) in front and set
# AGENTKIT_AUTH=proxy, or have clients send OIDC bearer tokens and set AGENTKIT_AUTH=jwt.
{$DOMAIN} {
	encode zstd gzip
	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		-Server
	}
	# Staff routes only from the campus network (replace with AUC ranges) [VERIFY]
	# @staff_outside {
	# 	path /admin* /metrics
	# 	not remote_ip 10.0.0.0/8
	# }
	# respond @staff_outside 403
	request_body {
		max_size 30MB
	}
	# Identity headers come only from the SSO step: drop any a client sends (request_header runs before
	# forward_auth), then add the secret the app checks (AGENTKIT_PROXY_SECRET).
	request_header -X-Forwarded-User
	request_header -X-Forwarded-Groups
	# forward_auth oauth2-proxy:4180 {
	# 	uri /oauth2/auth
	# 	copy_headers X-Auth-Request-Email>X-Forwarded-User X-Auth-Request-Groups>X-Forwarded-Groups
	# }
	reverse_proxy app:8000 {
		header_up X-Proxy-Secret {$AGENTKIT_PROXY_SECRET}
	}
}
